{
  "name": "stylelint-config-css-modules",
  "version": "4.6.0",
  "description": "CSS modules shareable config for stylelint",
  "keywords": [
    "stylelint",
    "stylelint-config",
    "css-modules"
  ],
  "author": {
    "name": "Pascal Duez",
    "url": "https://github.com/pascalduez"
  },
  "homepage": "https://github.com/pascalduez/stylelint-config-css-modules",
  "bugs": "https://github.com/pascalduez/stylelint-config-css-modules/issues",
  "repository": {
    "type": "git",
    "url": "git://github.com/pascalduez/stylelint-config-css-modules.git"
  },
  "license": "Unlicense",
  "files": [
    "CHANGELOG.md",
    "dist/**/*.js",
    "dist/**/*.cjs",
    "README.md",
    "UNLICENSE"
  ],
  "type": "module",
  "main": "./dist/index.cjs",
  "exports": {
    "import": "./dist/index.js",
    "require": "./dist/index.cjs"
  },
  "scripts": {
    "format": "oxfmt",
    "format:check": "oxftm --check",
    "test": "node --test",
    "build": "rollup -c",
    "prepare": "pnpm build"
  },
  "packageManager": "pnpm@10.28.1+sha512.7d7dbbca9e99447b7c3bf7a73286afaaf6be99251eb9498baefa7d406892f67b879adb3a1d7e687fc4ccc1a388c7175fbaae567a26ab44d1067b54fcb0d6a316",
  "devDependencies": {
    "oxfmt": "^0.26.0",
    "postcss": "^8.5.6",
    "rollup": "^4.56.0",
    "stylelint": "^17.0.0",
    "stylelint-config-standard": "^40.0.0",
    "stylelint-config-standard-scss": "^17.0.0"
  },
  "peerDependencies": {
    "stylelint": "^14.5.1 || ^15.0.0 || ^16.0.0 || ^17.0.0"
  },
  "optionalDependencies": {
    "stylelint-scss": "^7.0.0"
  }
}
