{
  "name": "stylelint-config-css-modules",
  "version": "4.6.0",
  "description": "CSS modules shareable config for stylelint",
  "keywords": [
    "stylelint",
    "stylelint-config",
    "css-modules"
  ],
  "author": {
    "name": "Pascal Duez",
    "url": "https://github.com/pascalduez"
  },
  "homepage": "https://github.com/pascalduez/stylelint-config-css-modules",
  "bugs": "https://github.com/pascalduez/stylelint-config-css-modules/issues",
  "repository": {
    "type": "git",
    "url": "git://github.com/pascalduez/stylelint-config-css-modules.git"
  },
  "license": "Unlicense",
  "files": [
    "CHANGELOG.md",
    "dist/**/*.js",
    "dist/**/*.cjs",
    "README.md",
    "UNLICENSE"
  ],
  "type": "module",
  "main": "./dist/index.cjs",
  "exports": {
    "import": "./dist/index.js",
    "require": "./dist/index.cjs"
  },
  "scripts": {
    "format": "oxfmt",
    "format:check": "oxftm --check",
    "test": "node --test",
    "build": "rollup -c",
    "prepare": "pnpm build"
  },
  "devEngines": {
    "runtime": {
      "name": "node",
      "version": "^24.0.0",
      "onFail": "download"
    },
    "packageManager": {
      "name": "pnpm",
      "version": "^12.0.0",
      "onFail": "download"
    }
  },
  "devDependencies": {
    "postcss": "^8.5.32",
    "prettier": "^3.9.10",
    "rollup": "^4.67.4",
    "stylelint": "^17.0.0",
    "stylelint-config-standard": "^40.0.0",
    "stylelint-config-standard-scss": "^17.0.0"
  },
  "peerDependencies": {
    "stylelint": "^14.5.1 || ^15.0.0 || ^16.0.0 || ^17.0.0"
  },
  "optionalDependencies": {
    "stylelint-scss": "^7.4.0"
  }
}
